<?xml version="1.0" encoding="utf-8"?>
<!-- 电脑端同步服务走局域网 HTTP，Android 9+ 默认禁止明文流量，这里统一放开 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
