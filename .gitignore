seeds.txt
usage.txt

# Room：app/schemas/** 需要入库（迁移测试依赖它），不要忽略

# 本机部署 / 备份目录（不入库）
/backup/
/local/
# 交付包目录与压缩包（构建产物，按需单独交付，不入库）
/交付包/
/配件管理PDA-v0.1.0-交付包.zip
# 协作工具的过程记忆与补丁备份（不入库）
/.workbuddy/
# 临时验证产物（备份副本、payload、截图等，不入库）
/.tmp_t/

# ===== Python（配套脚本/服务端）=====
__pycache__/
*.py[cod]
.venv/
venv/
*.spec
# 同步服务的运行数据（含配对令牌与 SQLite，不入库）
/pc-server/data/

